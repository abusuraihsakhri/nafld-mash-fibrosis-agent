{
  "openapi": "3.1.0",
  "info": {
    "title": "MASLD Fibrosis Calculator and Legacy Audit API",
    "description": "Clinical FIB-4/NFS scores are distinct from the preserved generic legacy audit functions.",
    "version": "2.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "API health check",
        "responses": {
          "200": {
            "description": "Service available"
          }
        }
      }
    },
    "/api/fibrosis": {
      "post": {
        "summary": "Calculate FIB-4 and optional NAFLD Fibrosis Score",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "age",
                  "ast",
                  "alt",
                  "platelets"
                ],
                "properties": {
                  "age": {
                    "type": "number",
                    "description": "Completed years, 18–120"
                  },
                  "ast": {
                    "type": "number",
                    "description": "U/L"
                  },
                  "alt": {
                    "type": "number",
                    "description": "U/L"
                  },
                  "platelets": {
                    "type": "number",
                    "description": "10^9/L"
                  },
                  "bmi": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "kg/m^2; optional NFS"
                  },
                  "albumin": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "g/dL; optional NFS"
                  },
                  "impaired_fasting_glucose_or_diabetes": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "description": "Optional NFS"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Risk-score estimates (not fibrosis staging or MASH diagnosis)"
          },
          "422": {
            "description": "Invalid clinical inputs"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy generic task audit (not a validated fibrosis assessment)",
        "responses": {
          "200": {
            "description": "Legacy dossier"
          },
          "422": {
            "description": "Invalid or blocked input"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic legacy mock chat",
        "responses": {
          "200": {
            "description": "Mock response"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON counters for legacy audits",
        "responses": {
          "200": {
            "description": "JSON counters"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Protected in-memory HMAC audit metadata",
        "security": [
          {
            "auditBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Audit metadata"
          },
          "403": {
            "description": "No valid AUDIT_LOG_READ_TOKEN configured or provided"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "auditBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The separately configured AUDIT_LOG_READ_TOKEN (minimum 24 characters)"
      }
    }
  }
}
